# Database
DATABASE_URL=postgresql://...

# Redis
# Docker Compose provides this value internally. Set it explicitly for non-Docker runs.
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=...
JWT_EXPIRES_IN=...

# OpenRouteService
ORS_API_KEY=...

# OpenRouter (AI) — optional secondary extraction provider. Leave OPENROUTER_API_KEY
# empty to disable OpenRouter fallback (Gemini becomes the only AI provider).
OPENROUTER_API_KEY=...
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Google Gemini (primary AI extraction provider — free tier supported).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.6-flash

# Job extraction pipeline: deterministic rule parser first, AI only fills
# low-confidence fields. 0.7 = rule confidence at/above 70% skips AI.
EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Resend
RESEND_API_KEY=...
RESEND_IMPORT_DOMAIN=inbound.notaryday.app
# Resend webhook signing secret (whsec_... from the Resend dashboard)
RESEND_WEBHOOK_SECRET=...
RESEND_FROM_ADDRESS=Notary Day <noreply@notaryday.app>

# Brevo (alternative transactional email provider — set BREVO_API_KEY to enable)
BREVO_API_KEY=
BREVO_FROM_ADDRESS=Notary Day <noreply@notaryday.app>

# Public PNG branding assets used in delivered email HTML.
# Set this to the DIRECTORY URL (no filename). The server appends
# /notaryday-original.png etc. itself, and also tolerates a base that
# already ends in a known asset filename.
EMAIL_ASSET_BASE_URL=https://assets.notaryday.app/icons

# Native Web Push (generate with: npx web-push generate-vapid-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@notaryday.app

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=...
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID=...

# Google Calendar
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=notaryday-uploads

# App
APP_URL=https://notaryday.app
# Comma-separated allowed CORS origins. Empty = only APP_URL is allowed.
CORS_ORIGINS=https://demo.notaryday.app,https://notaryday.app,https://notaryday.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:4000,http://127.0.0.1:4000
NODE_ENV=production
PORT=4000

# Bot blocking (blacklist of automation User-Agents on public endpoints)
# Modes: LIVE blocks requests, DRY_RUN logs only. BOT_BLOCK_EXTRA_UA accepts a
# comma-separated list of regex patterns to add to the built-in blacklist.
BOT_BLOCK_ENABLED=true
BOT_BLOCK_MODE=LIVE
BOT_BLOCK_REQUIRE_UA=true
BOT_BLOCK_EXTRA_UA=

# Sentry (error monitoring). Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# PostHog (product analytics). Leave POSTHOG_API_KEY empty to disable.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false

# New-account Pro trial. When TRIAL_PLAN=true, every new account is created
# on Pro Monthly for TRIAL_DAYS days (plan_expires_at = now + TRIAL_DAYS) and
# is downgraded to Free automatically when it lapses.
TRIAL_PLAN=true
TRIAL_DAYS=30

# Permanently purge soft-deleted records after this many days.
SOFT_DELETE_RETENTION_DAYS=90

# Admin dashboard bootstrap (used by `prisma db seed` to create the admin login)
ADMIN_EMAIL=change-me@notaryday.app
ADMIN_PASSWORD=change-me

# Marketing / CRM (separate MongoDB, multi-provider campaign email)
# MongoDB connection string (e.g. MongoDB Atlas: mongodb+srv://user:pass@cluster/...)
# IMPORTANT: include the database name in the path (e.g. .../notaryday_marketing).
# Without it everything silently lands in the driver's default "test" database,
# and an API/worker started with different URIs will read different databases.
MONGODB_URI=mongodb://localhost:27017/notaryday_marketing
# 32+ char random string used to AES-256-GCM encrypt email provider
# credentials stored in MongoDB. Generate with: openssl rand -hex 32
MARKETING_CREDENTIALS_KEY=change-me-32-chars-minimum-xxxxxxxx
# Webhook signing secrets for delivery events (optional in dev)
MARKETING_WEBHOOK_SECRET_RESEND=
# Public base URL for tracking pixels / click redirects. MUST point at the API
# (e.g. https://api.notaryday.app), not the frontend. Defaults to APP_URL.
MARKETING_PUBLIC_BASE_URL=http://localhost:4000
# Unsubscribe page base URL (defaults to APP_URL)
MARKETING_UNSUB_BASE_URL=
# CAN-SPAM physical postal address appended to marketing email footers
MARKETING_PHYSICAL_ADDRESS=
