# Database
DATABASE_URL=postgresql://...

# Redis (Upstash)
UPSTASH_REDIS_URL=rediss://...  # ioredis connects via TLS

# JWT
JWT_SECRET=...
JWT_EXPIRES_IN=...

# OpenRouteService
ORS_API_KEY=...

# OpenRouter (AI)
OPENROUTER_API_KEY=...
OPENROUTER_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Resend
RESEND_API_KEY=...
RESEND_IMPORT_DOMAIN=inbound.notaryday.app
RESEND_FROM_ADDRESS=Notary Day <noreply@notaryday.app>

# Native Web Push (generate with: npx web-push generate-vapid-keys)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@notaryday.app

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=...
LEMONSQUEEZY_STORE_ID=...
LEMONSQUEEZY_WEBHOOK_SECRET=...
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=...
LEMONSQUEEZY_PRO_ANNUAL_VARIANT_ID=...

# Google Calendar
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=notaryday-uploads

# App
APP_URL=https://notaryday.app
NODE_ENV=production
PORT=3001
