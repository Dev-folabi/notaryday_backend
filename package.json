{
  "name": "notaryday_backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build && cp -r generated dist/ && mkdir -p dist/src/common/email && cp -r src/common/email/assets dist/src/common/email/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "start:dev:api": "nest start --watch",
    "start:staging": "concurrently \"node dist/src/main\" \"node dist/src/main-worker\"",
    "start:staging:dev": "concurrently \"nest start --watch\" \"ts-node -r tsconfig-paths/register src/main-worker.ts\"",
    "start:worker": "node dist/src/main-worker",
    "start:dev:worker": "ts-node -r tsconfig-paths/register src/main-worker.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@google/genai": "^2.19.0",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.6.0",
    "@sentry/nestjs": "^10.70.0",
    "@types/web-push": "^3.6.4",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.0",
    "chrono-node": "^2.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^10.0.5",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "html-to-text": "^10.0.1",
    "ical-generator": "^10.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.49.1",
    "prisma": "^7.6.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^generated/prisma$": "<rootDir>/../generated/prisma"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
